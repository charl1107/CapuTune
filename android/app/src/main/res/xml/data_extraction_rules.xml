<?xml version="1.0" encoding="utf-8"?>
<!--
  Uninstalling the app must permanently discard all app data (playlists,
  favorites, downloads, settings, play counts). Nothing is backed up to the
  cloud and nothing is transferred during device-to-device migration, so the
  user cannot silently recover state after an uninstall.

  Files the user explicitly copied out via "Save to device" live in the public
  Downloads folder and are therefore not affected by this.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
